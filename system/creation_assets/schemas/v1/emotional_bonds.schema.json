{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nrl.local/schemas/v1/emotional_bonds.schema.json",
  "title": "Generic Emotional Bond Asset v1",
  "allOf": [
    {"$ref": "https://nrl.local/schemas/v1/common.schema.json"},
    {
      "required": ["emotional_bond"],
      "properties": {
        "family": {"const": "emotional_bonds"},
        "emotional_bond": {
          "type": "object",
          "required": ["bond_type", "participant_ids", "current_state", "change_triggers", "boundaries"],
          "properties": {
            "bond_type": {"type": "string", "minLength": 1},
            "participant_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
            "current_state": {"type": "string", "minLength": 1},
            "change_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
