{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StateLedger",
  "description": "Schema for tracking character status, assets, dual-track identity masks, and faction standings.",
  "type": "object",
  "properties": {
    "true_profile": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "combat_power": {
          "type": "integer"
        },
        "moral_threshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 50
        },
        "utility_priority": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "default": 0.5
        },
        "symbiotic_entities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": ["name"]
          }
        }
      },
      "required": ["actor_id", "name", "level"]
    },
    "public_mask": {
      "type": "object",
      "properties": {
        "is_mask_active": {
          "type": "boolean",
          "default": false
        },
        "masked_name": {
          "type": "string"
        },
        "masked_level": {
          "type": "string"
        },
        "masked_combat_power": {
          "type": "integer"
        }
      },
      "required": ["is_mask_active"]
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_name": {
            "type": "string"
          },
          "item_type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "backlash_description": {
            "type": "string"
          },
          "trigger_condition": {
            "type": "string"
          }
        },
        "required": ["item_name", "item_type"]
      }
    },
    "faction_reputation": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": -100,
        "maximum": 100
      }
    }
  },
  "required": ["true_profile", "public_mask", "inventory", "faction_reputation"]
}
