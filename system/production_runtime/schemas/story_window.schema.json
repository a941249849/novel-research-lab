{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nrl://production/story-window-v1",
  "type": "object",
  "required": ["version", "project", "volume", "window", "status", "start_snapshot", "end_target", "chapters"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "project": {"type": "string", "minLength": 1},
    "volume": {"type": "integer", "minimum": 1},
    "window": {
      "type": "object",
      "required": ["start", "end", "name"],
      "properties": {
        "start": {"type": "integer", "minimum": 1},
        "end": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "status": {"type": "string", "enum": ["candidate", "reviewed", "production_ready", "frozen"]},
    "review_policy": {
      "type": "object",
      "required": ["sol_window_review_required", "independent_antigravity_required", "publish_authorized"],
      "properties": {
        "sol_window_review_required": {"type": "boolean"},
        "independent_antigravity_required": {"type": "boolean"},
        "publish_authorized": {"const": false}
      },
      "additionalProperties": false
    },
    "start_snapshot": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "end_target": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "chapters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["chapter_id", "working_title", "event", "scene_anchor", "conflict", "character_choice", "irreversible_change", "emotional_turn", "hook_out", "expected_state_deltas", "required_asset_ids", "source_status"],
        "properties": {
          "chapter_id": {"type": "string", "pattern": "^chapter-[0-9]{4}$"},
          "working_title": {"type": "string", "minLength": 2},
          "event": {"type": "string", "minLength": 12},
          "scene_anchor": {"type": "string", "minLength": 4},
          "conflict": {"type": "string", "minLength": 12},
          "character_choice": {"type": "string", "minLength": 12},
          "irreversible_change": {"type": "string", "minLength": 12},
          "emotional_turn": {"type": "string", "minLength": 8},
          "hook_out": {"type": "string", "minLength": 8},
          "expected_state_deltas": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "required_asset_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "cultural_safety_checks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_status": {"type": "string", "enum": ["accepted_calibration", "planned", "formal_plan"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
