{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nrl.local/schemas/v1/techniques.schema.json",
  "title": "Generic Technique Asset v1",
  "allOf": [
    {"$ref": "https://nrl.local/schemas/v1/common.schema.json"},
    {
      "required": ["technique"],
      "properties": {
        "family": {"const": "techniques"},
        "technique": {
          "type": "object",
          "required": ["narrative_function", "prerequisites", "costs", "limitations", "progression"],
          "properties": {
            "narrative_function": {"type": "string", "minLength": 1},
            "prerequisites": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "costs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "progression": {
              "type": "object",
              "required": ["trigger", "next_state"],
              "properties": {
                "trigger": {"type": "string", "minLength": 1},
                "next_state": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "related_asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
