{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NarrativeDNA",
  "description": "Schema for defining the pacing, checkpoints, and tension structure of a novel plot.",
  "type": "object",
  "properties": {
    "plot_checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tension": {
            "type": "integer",
            "minimum": -10,
            "maximum": 10
          },
          "is_combat_skippable": {
            "type": "boolean"
          },
          "evasion_path": {
            "type": "string"
          }
        },
        "required": ["node_id", "title", "tension"]
      }
    },
    "pacing_metrics": {
      "type": "object",
      "properties": {
        "target_suppression_to_release_ratio": {
          "type": "string",
          "default": "1:3"
        },
        "description": {
          "type": "string"
        }
      }
    }
  },
  "required": ["plot_checkpoints"]
}
