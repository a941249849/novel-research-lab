{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nrl.local/schemas/naming.schema.json",
  "title": "Naming Rule Asset",
  "allOf": [
    {"$ref": "https://nrl.local/schemas/common.schema.json"},
    {
      "properties": {
        "family": {"type": "string", "const": "naming"},
        "naming": {
          "type": "object",
          "required": [
            "semantic_field",
            "naming_roots",
            "form_rules",
            "forbidden_collisions",
            "forbidden_terms",
            "originality_policy"
          ],
          "properties": {
            "semantic_field": {"type": "string", "minLength": 1},
            "naming_roots": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "form_rules": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "forbidden_collisions": {
              "type": "array",
              "items": {"type": "string"}
            },
            "forbidden_terms": {
              "type": "array",
              "items": {"type": "string"}
            },
            "originality_policy": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
