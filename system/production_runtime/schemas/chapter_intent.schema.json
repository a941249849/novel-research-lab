{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nrl://production/chapter-intent-v0.20",
  "type": "object",
  "required": ["chapter_id", "dramatic_purpose", "must_keep", "must_avoid", "expected_state_deltas"],
  "properties": {
    "chapter_id": {"type": "string", "pattern": "^chapter-[0-9]{4}$"},
    "dramatic_purpose": {"type": "string", "minLength": 1},
    "must_keep": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "must_avoid": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expected_state_deltas": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
