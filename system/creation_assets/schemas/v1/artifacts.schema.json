{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nrl.local/schemas/v1/artifacts.schema.json",
  "title": "Generic Artifact Asset v1",
  "allOf": [
    {"$ref": "https://nrl.local/schemas/v1/common.schema.json"},
    {
      "required": ["artifact"],
      "properties": {
        "family": {"const": "artifacts"},
        "artifact": {
          "type": "object",
          "required": ["narrative_function", "acquisition", "costs", "limitations", "evolution"],
          "properties": {
            "narrative_function": {"type": "string", "minLength": 1},
            "acquisition": {"type": "string", "minLength": 1},
            "costs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "evolution": {
              "type": "object",
              "required": ["trigger", "next_state"],
              "properties": {
                "trigger": {"type": "string", "minLength": 1},
                "next_state": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "related_asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
