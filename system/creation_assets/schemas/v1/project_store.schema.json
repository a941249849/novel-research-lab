{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nrl.local/schemas/v1/project_store.schema.json",
  "title": "NRL Generic Project Creation Asset Store v1",
  "type": "object",
  "required": ["version", "project_id", "project", "assets"],
  "properties": {
    "version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "assets": {"type": "array"}
  },
  "additionalProperties": false
}
