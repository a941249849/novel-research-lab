{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nrl.local/schemas/common.schema.json",
  "title": "NRL Creation Asset Envelope",
  "type": "object",
  "required": [
    "asset_id",
    "family",
    "display_name",
    "lifecycle_state",
    "source_refs",
    "relationships",
    "constraints"
  ],
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "family": {
      "enum": [
        "characters",
        "npcs",
        "factions",
        "artifacts",
        "techniques",
        "naming",
        "emotional_bonds",
        "foreshadowing",
        "state_ledger"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_state": {
      "enum": ["seed", "active", "dormant", "retired"]
    },
    "previous_lifecycle_state": {
      "enum": ["seed", "active", "dormant", "retired"]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_id", "relation_type"],
        "properties": {
          "target_id": {"type": "string"},
          "relation_type": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
