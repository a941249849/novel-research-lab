{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nrl.local/schemas/v1/state_ledger.schema.json",
  "title": "Generic State Ledger Asset v1",
  "allOf": [
    {"$ref": "https://nrl.local/schemas/v1/common.schema.json"},
    {
      "required": ["state_ledger"],
      "properties": {
        "family": {"const": "state_ledger"},
        "state_ledger": {
          "type": "object",
          "required": ["state_key", "value_type", "owners", "update_rules", "invariants"],
          "properties": {
            "state_key": {"type": "string", "minLength": 1},
            "value_type": {"type": "string", "minLength": 1},
            "owners": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "update_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "invariants": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "related_asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
