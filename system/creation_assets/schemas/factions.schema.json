{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nrl.local/schemas/factions.schema.json",
  "title": "Faction Asset",
  "allOf": [
    {"$ref": "https://nrl.local/schemas/common.schema.json"},
    {
      "properties": {
        "family": {"type": "string", "const": "factions"},
        "faction": {
          "type": "object",
          "required": [
            "interest",
            "pressure_level",
            "tax_enforcement_role",
            "associated_ledger_states",
            "cohort_capacity",
            "threat_exposure_coefficient",
            "lifecycle_policy",
            "originality_policy"
          ],
          "properties": {
            "interest": {"type": "string", "minLength": 1},
            "pressure_level": {"type": "integer", "minimum": 0},
            "tax_enforcement_role": {"type": "string", "minLength": 1},
            "associated_ledger_states": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "cohort_capacity": {"type": "integer", "minimum": 0},
            "threat_exposure_coefficient": {"type": "number", "minimum": 0},
            "lifecycle_policy": {
              "type": "object",
              "required": ["establishment", "alliance_shift", "territorial_expansion", "retirement"],
              "properties": {
                "establishment": {"type": "string", "minLength": 1},
                "alliance_shift": {"type": "string", "minLength": 1},
                "territorial_expansion": {"type": "string", "minLength": 1},
                "retirement": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "originality_policy": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
