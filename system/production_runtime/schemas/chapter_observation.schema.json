{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "nrl://production/chapter-observation-v0.20",
  "type": "object",
  "required": ["chapter_id", "draft_sha256", "facts"],
  "definitions": {
    "fact": {
      "type": "object",
      "required": ["fact_id", "asset_id", "field_path", "before", "after", "evidence"],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "asset_id": {"type": "string", "minLength": 1},
        "field_path": {"type": "string", "minLength": 1},
        "before": {},
        "after": {},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "chapter_id": {"type": "string", "pattern": "^chapter-[0-9]{4}$"},
    "draft_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "facts": {
      "type": "object",
      "required": ["characters", "npcs", "locations", "factions", "artifacts", "techniques", "relationships", "emotions", "information", "hooks", "timeline", "physical_state", "naming"],
      "properties": {
        "characters": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
        "npcs": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
        "locations": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
        "factions": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
        "artifacts": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
        "techniques": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
        "relationships": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
        "emotions": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
        "information": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
        "hooks": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
        "timeline": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
        "physical_state": {"type": "array", "items": {"$ref": "#/definitions/fact"}},
        "naming": {"type": "array", "items": {"$ref": "#/definitions/fact"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
