{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nrl.local/schemas/v1/factions.schema.json",
  "title": "Generic Faction Asset v1",
  "allOf": [
    {"$ref": "https://nrl.local/schemas/v1/common.schema.json"},
    {
      "required": ["faction"],
      "properties": {
        "family": {"const": "factions"},
        "faction": {
          "type": "object",
          "required": ["purpose", "interests", "pressure_sources", "operating_rules"],
          "properties": {
            "purpose": {"type": "string", "minLength": 1},
            "interests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "pressure_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "operating_rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "related_asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
