{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nrl.local/schemas/v1/characters.schema.json",
  "title": "Generic Character Asset v1",
  "allOf": [
    {"$ref": "https://nrl.local/schemas/v1/common.schema.json"},
    {
      "required": ["character"],
      "properties": {
        "family": {"const": "characters"},
        "character": {
          "type": "object",
          "required": ["narrative_role", "goals", "conflicts", "arc", "capabilities"],
          "properties": {
            "narrative_role": {"type": "string", "minLength": 1},
            "goals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "conflicts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "arc": {
              "type": "object",
              "required": ["starting_state", "change_pressure", "target_state"],
              "properties": {
                "starting_state": {"type": "string", "minLength": 1},
                "change_pressure": {"type": "string", "minLength": 1},
                "target_state": {"type": "string", "minLength": 1},
                "volume1_terminal_state": {"type": "string", "minLength": 1},
                "series_target_state": {"type": "string", "minLength": 1},
                "residual_conflict": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            },
            "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "related_asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
